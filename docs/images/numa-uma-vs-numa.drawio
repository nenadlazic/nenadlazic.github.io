<mxfile host="app.diagrams.net">
  <diagram id="uma-numa" name="UMA vs NUMA">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="tU" value="UMA - Uniform Memory Access" style="text;html=1;align=center;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="360" height="30" as="geometry"/></mxCell>
        <mxCell id="uCPU" value="CPU - all cores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="70" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="uRAM" value="RAM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="140" y="230" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="uE" value="one shared bus" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=12;fontColor=#555555;" edge="1" parent="1" source="uCPU" target="uRAM"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="uCap" value="Every core sees memory at the same latency.&#10;The bus is the bottleneck: more cores fight for one path." style="text;html=1;align=center;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="360" height="50" as="geometry"/></mxCell>

        <mxCell id="split" value="split RAM&#10;per socket" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=13;fontStyle=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="180" as="sourcePoint"/><mxPoint x="500" y="180" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="tN" value="NUMA - Non-Uniform Memory Access" style="text;html=1;align=center;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="540" y="20" width="380" height="30" as="geometry"/></mxCell>
        <mxCell id="s0" value="Socket 0&#10;local cores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="70" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="s1" value="Socket 1&#10;local cores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="70" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="ic" value="interconnect - narrow, slower" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#b85450;fontSize=11;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r0" value="RAM 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="240" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="r1" value="RAM 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="240" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="e0" value="local = fast" style="endArrow=classic;html=1;strokeColor=#82b366;fontSize=12;fontColor=#2d7d2d;fontStyle=1;" edge="1" parent="1" source="s0" target="r0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="local = fast" style="endArrow=classic;html=1;strokeColor=#82b366;fontSize=12;fontColor=#2d7d2d;fontStyle=1;" edge="1" parent="1" source="s1" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ex" value="remote = slow" style="endArrow=classic;html=1;strokeColor=#b85450;fontSize=12;fontColor=#b85450;fontStyle=1;dashed=1;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="s0" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="nCap" value="Capacity and bandwidth doubled - but now it matters where you read from." style="text;html=1;align=center;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="540" y="335" width="380" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
