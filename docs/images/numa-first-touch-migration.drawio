<mxfile host="app.diagrams.net">
  <diagram id="firsttouch" name="First-touch migration">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="470" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="tL" value="1 · First touch - pages land on the node that runs the thread" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="440" height="24" as="geometry"/></mxCell>
        <mxCell id="s0L" value="Socket 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#6c8ebf;verticalAlign=top;fontSize=12;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="thL" value="encoder&#10;thread" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="95" width="120" height="55" as="geometry"/></mxCell>
        <mxCell id="s1L" value="Socket 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#bbbbbb;verticalAlign=top;fontSize=12;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="260" y="60" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="r0L" value="RAM 0&#10;pages allocated here" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="r1L" value="RAM 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#bbbbbb;fontSize=12;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="260" y="230" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="eL" value="local, fast" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontColor=#2d7d2d;fontStyle=1;" edge="1" parent="1" source="thL" target="r0L"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="tR" value="2 · Scheduler migrates the thread - the pages do not follow" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="510" y="18" width="440" height="24" as="geometry"/></mxCell>
        <mxCell id="s0R" value="Socket 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#bbbbbb;verticalAlign=top;fontSize=12;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="520" y="60" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="s1R" value="Socket 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#6c8ebf;verticalAlign=top;fontSize=12;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="740" y="60" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="thR" value="encoder&#10;thread" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="95" width="120" height="55" as="geometry"/></mxCell>
        <mxCell id="r0R" value="RAM 0&#10;pages still here" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="230" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="r1R" value="RAM 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#bbbbbb;fontSize=12;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="740" y="230" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="eR" value="remote - 2-3× slower" style="endArrow=classic;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;fontSize=12;fontColor=#b85450;fontStyle=1;exitX=0.25;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="thR" target="r0R"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="cap" value="Output is bit-identical. Every core still reads 100% busy in htop - a core stalled on a remote fetch is not an idle core. You simply get fewer jobs per box, and file it under &quot;that's what this hardware does.&quot;" style="text;html=1;align=center;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="840" height="50" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
