        <mxCell id="knob" value="Both knobs or neither:  CPU affinity (else the thread migrates)  +  memory policy (else it reads remotely)." style="text;html=1;align=center;fontSize=11;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="80" y="366" width="700" height="20" as="geometry"/></mxCell>
