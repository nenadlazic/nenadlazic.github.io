        <mxCell id="dep" value="Dependencies both levels share" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=12;fontColor=#666666;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="780" height="130" as="geometry"/></mxCell>
        <mxCell id="db" value="Database&#10;stretched across sites&#10;promotion: manual?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="290" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="mb" value="Message broker&#10;brokers of one site only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="290" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="sr" value="Secrets · registry · CI&#10;on the primary site" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="290" width="220" height="70" as="geometry"/></mxCell>

