<mxfile host="app.diagrams.net">
  <diagram id="hatwolevels" name="Two levels of HA">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="470" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t" value="Two levels of HA - and what sits underneath both" style="text;html=1;align=center;fontSize=15;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="16" width="740" height="26" as="geometry"/></mxCell>

        <mxCell id="cp" value="Primary cluster · gets the traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#6c8ebf;verticalAlign=top;fontSize=12;fontColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="340" height="150" as="geometry"/></mxCell>
        <mxCell id="p1" value="service&#10;replica 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="100" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="p2" value="service&#10;replica 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="l1" value="Level 1: replicas inside one cluster · survives a pod or node" style="text;html=1;align=center;fontSize=11;fontColor=#2d7d2d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="165" width="320" height="30" as="geometry"/></mxCell>

        <mxCell id="cb" value="Backup cluster · standby" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#6c8ebf;verticalAlign=top;fontSize=12;fontColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="60" width="340" height="150" as="geometry"/></mxCell>
        <mxCell id="b1" value="service&#10;replica 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="100" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="b2" value="service&#10;replica 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="100" width="120" height="50" as="geometry"/></mxCell>

