        <mxCell id="cap" value="A service is exactly as available as the least available thing it cannot work without." style="text;html=1;align=center;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="395" width="780" height="24" as="geometry"/></mxCell>
